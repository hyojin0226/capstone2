        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time, traffic_class, flows\nFROM capstone.traffic_by_class_10s\nWHERE $__timeFilter(window_start) AND traffic_class NOT IN ('unknown', 'background', 'unclassified')\nORDER BY time",
          "pluginVersion": "4.22.1"
        }
