    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "전체 트래픽: 분류 / unknown / 배경 / 미분류 플로우 / 10초",
      "description": "unknown = 추론했지만 확신도 미달, background = F2 필터에서 걸러진 배경 트래픽, unclassified = F2는 통과했지만 soft 품질 검사 실패",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT window_start AS time,\n       if(traffic_class IN ('unknown', 'background', 'unclassified'), traffic_class, 'classified') AS kind,\n       sum(flows) AS flows\nFROM capstone.traffic_by_class_10s\nWHERE $__timeFilter(window_start)\nGROUP BY time, kind\nORDER BY time",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "displayName": "${__field.labels.kind}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
